<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CourierServiceManagement.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>My Courier Service</title>

    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="<%= ResolveUrl("~/Style/Site.css") %>" />  
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <!-- ScriptManager -->
    <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

    <!-- HEADER -->
    <div class="header">
        MY COURIER SERVICE
    </div>

    <!-- MENU -->
    <div class="menu">
        <a href="Home.aspx">Home</a>
        <a href="Service.aspx">Service</a>
        <a href="Register.aspx">Register</a>
        <a href="Login.aspx">Login</a>
        <a href="CourierBooking.aspx">Book Courier</a>
        <a href="TrackCourier.aspx">Track Courier</a>
    </div>

    <!-- CONTENT -->
    <div class="container">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </div>

    <!-- FOOTER -->
    <div class="footer">
        © <%= DateTime.Now.Year %> My Courier Service
    </div>

</form>
</body>
</html>